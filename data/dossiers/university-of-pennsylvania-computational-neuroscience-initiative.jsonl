{"name": "Eleni Katifori", "institution": "University of Pennsylvania", "department": "Computational Neuroscience Initiative", "title_on_roster": "", "roster_url": "https://www.cni.upenn.edu/people", "profile_url": "http://web.sas.upenn.edu/katifori/", "filter": "ml_only", "ai_venues": null, "first_paper": null, "heritage": null, "position_class": "other", "position": {"value": "", "evidence": {"source_url": "https://www.cni.upenn.edu/people", "quote": "Eleni Katifori (Physics)", "checked_on": "2026-10-30"}}, "email": null, "homepage": "https://web.sas.upenn.edu/katifori/people-2/", "lab_website": "https://web.sas.upenn.edu/katifori/", "google_scholar": null, "cv": null, "pubs": "https://web.sas.upenn.edu/katifori/publications/", "contact": "https://web.sas.upenn.edu/katifori/about/", "research": {"text": "We seek to uncover the physical principles that shape networks and soft matter, in living systems and beyond. Combining theory, mathematical modeling, and computation with experiments, we investigate how structure and dynamics govern transport, mechanics, and collective behavior. Our research spans the development and resilience of biological networks, the mechanisms that pump fluids, the emergence of memory and learning in physical systems, and the interplay of geometry and elasticity in shaping patterns and form. From plant veins and animal vasculature to fluidic and mechanical materials, we explore how local interactions give rise to complex organization and function.", "source_url": "http://web.sas.upenn.edu/katifori/"}, "recruiting": [], "start": [], "papers": [], "problems": ["papers: deferred"]}
