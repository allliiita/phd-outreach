{"name": "Nicole Rust", "institution": "University of Pennsylvania", "department": "Computational Neuroscience Initiative", "title_on_roster": "", "roster_url": "https://www.cni.upenn.edu/people", "profile_url": "http://www.sas.upenn.edu/psych/rust-lab/", "filter": "ml_only", "ai_venues": null, "first_paper": null, "heritage": null, "position_class": "associate", "position": {"value": "Associate Professor in the Department of Psychology and the Director of the Visual M", "evidence": {"source_url": "http://www.sas.upenn.edu/psych/rust-lab/people.html", "quote": "Nicole Rust, Ph.D. Contact Nicole Nicole C. Rust, PhD is an Associate Professor in the Department of Psychology and the Director of the Visual Memory Lab at the University of Pennsylvania in Philadelphia.", "checked_on": "2026-10-30"}}, "email": {"value": "nrust@sas.upenn.edu", "evidence": {"source_url": "http://www.sas.upenn.edu/psych/rust-lab/people.html", "quote": "<a href=\"mailto:nrust@sas.upenn.edu\" target=\"_top\">Contact Nicole</a>", "checked_on": "2026-10-30"}}, "homepage": "http://www.sas.upenn.edu/psych/rust-lab/people.html", "lab_website": null, "google_scholar": null, "cv": null, "pubs": "http://www.sas.upenn.edu/psych/rust-lab/publications.html", "contact": null, "research": {"text": "Home | Penn Visual Memory Lab Home The problem Our approach PI: Nicole Rust Publications Open Positions Menu We have a remarkable ability to remember the things that we have seen. Where and how are our visual memories stored? Learn More To study visual memory, we combine behavioral, neural and computational approaches. Learn More The compelling phenomenon that inspires our work: our massive-capacity, single-trial memory for pictures. Learn More Previous Next Follow our latest news on Twitter: @NicoleCRust", "source_url": "http://www.sas.upenn.edu/psych/rust-lab/"}, "recruiting": [], "start": [], "papers": [], "problems": ["papers: deferred"]}
{"name": "Anna Schapiro", "institution": "University of Pennsylvania", "department": "Computational Neuroscience Initiative", "title_on_roster": "", "roster_url": "https://www.cni.upenn.edu/people", "profile_url": "https://www.schapirolab.org/", "filter": "ml_only", "ai_venues": null, "first_paper": null, "heritage": null, "position_class": "assistant", "position": {"value": "Assistant Professor", "evidence": {"source_url": "https://www.schapirolab.org/people.html", "quote": "ists Sydney Bergstrom sydb@sas.upenn.edu Alumni Emily Cowan Assistant Professor, Adelphi University Cody Dong PhD student, Princeton Univer", "checked_on": "2026-10-30"}}, "email": {"value": "aschapir@sas.upenn.edu", "evidence": {"source_url": "https://www.schapirolab.org/people.html", "quote": "E PUBLICATIONS RESOURCES JOIN US Principal Investigator Anna Schapiro aschapir@sas.upenn.edu C.V. | Google Scholar Postdoctoral Fellows Xiaozhi (Taro) Yang xiaozh", "checked_on": "2026-10-30"}}, "homepage": "https://www.schapirolab.org/people.html", "lab_website": null, "google_scholar": "https://scholar.google.com/citations?user=s6NTSjwAAAAJ", "cv": null, "pubs": "https://www.schapirolab.org/publications.html", "contact": null, "research": {"text": "Some moments in our lives provide information that is useful in itself, but other information is most meaningful when combined across many instances, as we come to understand the regularities in the world. How do we extract such structured knowledge from our environment? Answering this question requires an understanding of the initial acquisition of this information as well as its stabilization and integration with existing knowledge structures over time and with sleep. Our research combines neural network modeling and empirical methods (fMRI, EEG, patient studies, behavior) to uncover learning algorithms and principles of how memories of regularities in the environment come to be represented throughout the brain.", "source_url": "https://www.schapirolab.org/"}, "recruiting": [], "start": [], "papers": [], "problems": ["papers: deferred"]}
