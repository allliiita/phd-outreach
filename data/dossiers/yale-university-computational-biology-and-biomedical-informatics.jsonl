{"name": "Inna Cohen", "institution": "Yale University", "department": "Computational Biology and Biomedical Informatics", "title_on_roster": "", "roster_url": "https://cbb.yale.edu/people", "profile_url": "https://medicine.yale.edu/profile/mark-iscoe/", "filter": "all", "ai_venues": null, "first_paper": null, "heritage": null, "position_class": "other", "position": {"value": "", "evidence": {"source_url": "https://cbb.yale.edu/people", "quote": "Inna Cohen - Iscoe lab - Meeker lab", "checked_on": "2026-10-30"}}, "email": null, "homepage": null, "lab_website": null, "google_scholar": null, "cv": null, "pubs": null, "contact": null, "research": {"text": "Dr. Iscoe is an assistant professor of Emergency Medicine and Biomedical Informatics & Data Science. In his research, he applies informatics techniques including real-world data analysis, natural language processing, and predictive modeling to various aspects of emergency care, with a focus on clinical decision-making in areas of diagnostic uncertainty or practice variation. Along with Dr. Daniella Meeker, he co-teaches CBB 576: Foundations of Real-World Data. He practices clinically at the Yale New Haven Hospital, Yale New Haven Hospital St. Raphael Campus, and Shoreline Medical Center emergency departments.", "source_url": "https://medicine.yale.edu/profile/mark-iscoe/"}, "recruiting": [], "start": [], "papers": [], "problems": ["papers: deferred"]}
